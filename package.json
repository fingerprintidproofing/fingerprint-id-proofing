{
  "name": "fingerprint-id-proofing",
  "version": "1.0.36",
  "description": "JavaScript browser fingerprinting and telemetry SDK for device signals, identity proofing, and fraud risk scoring.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fingerprintidproofing/fingerprint-npm.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "unpkg": "index.js",
  "jsdelivr": "index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./backend": {
      "types": "./backend.d.ts",
      "import": "./backend.js",
      "require": "./backend.cjs",
      "default": "./backend.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "backend.js",
    "backend.cjs",
    "backend.d.ts"
  ],
  "scripts": {
    "clean": "rm -f index.js backend.js",
    "build:client": "javascript-obfuscator src/index.js --output ./index.js --compact true --self-defending true --string-array true --string-array-encoding 'rc4' --string-array-threshold 1 --control-flow-flattening true --control-flow-flattening-threshold 1 --dead-code-injection true --dead-code-injection-threshold 1",
    "build:server": "cp src/backend.js ./backend.js && cp src/backend.cjs ./backend.cjs",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "fingerprint",
    "browser-fingerprinting",
    "device-fingerprint",
    "browser-telemetry",
    "identity-proofing",
    "identity-verification",
    "risk-score",
    "risk-scoring",
    "fraud-detection",
    "device-intelligence",
    "visitor-id",
    "javascript-sdk",
    "typescript",
    "authentication"
  ],
  "author": "fingerprint-id-proofing Team",
  "license": "MIT",
  "devDependencies": {
    "javascript-obfuscator": "^5.9.0",
    "happy-dom": "^21.0.1"
  }
}
